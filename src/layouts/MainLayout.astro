---
import "../styles/global.css";

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

import logo from "../assets/logo_submark.svg";
import defaultShareImage from "../assets/photos/hero.JPG";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	/** Krátky názov stránky, doplní sa o názov webu. */
	title: string;
	/** Celý <title>, ak nemá mať tvar „{title} | názov webu“ (napr. domovská stránka). */
	fullTitle?: string;
	/** Meta description – 1 až 2 vety, ideálne do 155 znakov. */
	description: string;
	/** Obrázok pre zdieľanie na sociálnych sieťach. */
	image?: ImageMetadata;
}

const SITE_NAME = "Robotický Battle na Alejovej";

const { title, fullTitle, description, image = defaultShareImage } = Astro.props;

const pageTitle = fullTitle ?? `${title} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const SHARE_WIDTH = 1200;
const SHARE_HEIGHT = 630;
const shareImage = await getImage({
	src: image,
	width: SHARE_WIDTH,
	height: SHARE_HEIGHT,
	fit: "cover",
	format: "jpg",
	quality: 80,
});
const shareImageURL = new URL(shareImage.src, Astro.site);
---


<html lang="sk">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={logo.src} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,200,0,0" />
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Tomorrow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="sk_SK" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={shareImageURL} />
		<meta property="og:image:width" content={SHARE_WIDTH} />
		<meta property="og:image:height" content={SHARE_HEIGHT} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
	</head>
	<body class="flex flex-col min-h-screen">
		<Navbar />
		<div class="pt-[72px] grow">
			<slot />
		</div>
		<Footer/>
		<script src="../scripts/nav.js"></script>
		<script src="../scripts/counter.js"></script>
	</body>
</html>