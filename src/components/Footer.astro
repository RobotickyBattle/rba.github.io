---
import logo from "../assets/logo_white.svg";
import fb from "../assets/icons/fb.svg";
import ig from "../assets/icons/ig.svg";
import yt from "../assets/icons/yt.svg";
---


<footer class="bg-orangeLight text-white">
  <div class="content px-4 py-8">

    <div class="flex flex-col md:flex-row items-center md:items-center md:justify-between gap-6">

      <!-- Left: Logo -->
      <div class="shrink-0">
        <a href="/" class="text-xl font-bold">
          <img src={logo.src} alt="Logo" class="h-10" />
        </a>
      </div>

      <!-- Center: Links -->
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm" aria-label="Odkazy v pätičke">
        <a href={`${import.meta.env.BASE_URL}rules/vseobecne-pravidla/`} class="title hover:underline underline-offset-4">Všeobecné pravidlá</a>
        <a href={`${import.meta.env.BASE_URL}gdpr/`} class="title hover:underline underline-offset-4">Ochrana osobných údajov</a>
      </nav>

      <!-- Right: Social Links -->
      <div class="flex gap-4">
        <a href="https://www.facebook.com/robotickybattle" target="_blank" aria-label="Facebook">
          	<img src={fb.src} alt="Facebook" class="h-8" />
        </a>
        <a href="https://www.instagram.com/robotickybattle" target="_blank" aria-label="Instagram">
          <img src={ig.src} alt="Instagram" class="h-8" />
        </a>
        <a href="https://www.youtube.com/@RobotickyBattlenaAlejovej" target="_blank" aria-label="YouTube">
          <img src={yt.src} alt="YouTube" class="h-8" />
        </a>
      </div>

    </div>

  </div>
</footer>
